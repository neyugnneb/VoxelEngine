{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",

                // source files
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\glad.c",
                "${workspaceFolder}\\src\\vertexBuffer.cpp",
                "${workspaceFolder}\\src\\vertexArray.cpp",
                "${workspaceFolder}\\src\\elementBuffer.cpp",
                "${workspaceFolder}\\src\\chunk.cpp",
                "${workspaceFolder}\\src\\world.cpp",


                // include directories
                "-I", "${workspaceFolder}\\include",
                "-I", "C:\\glfw-3.4.bin.WIN64\\include",
                "-I", "C:\\glew-2.1.0\\include",

                // library directories
                "-L", "C:\\glew-2.1.0\\lib\\Release\\x64",
                "-L", "C:\\glfw-3.4.bin.WIN64\\lib-mingw-w64",

                // output name
                "-o", "${fileDirname}\\test.exe",

                // link libraries (order matters after -o)
                "-lglfw3dll",
                "-lglew32",
                "-lopengl32"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}